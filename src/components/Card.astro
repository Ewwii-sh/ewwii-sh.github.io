---
// Props for the card
interface Props {
  title: string;
  description: string;
}
const { title, description, icon: Icon } = Astro.props;
---

<div class="card card-border shadow-md bg-base-300 w-full h-full border-bg-primary">
    <div class="card-body p-6">
        <div class="flex items-center gap-3">
            <div class="p-2.5 rounded-xl bg-primary/10 text-primary border border-primary/20 shrink-0">
                <Icon class="w-5 h-5 sm:w-6 sm:h-6 stroke-[2]" />
            </div>        
            <h2 class="card-title text-lg sm:text-xl font-bold text-base-content m-0 leading-tight">
                {title}
            </h2>
        </div>

        <p class="text-sm text-base-content/70 leading-relaxed mt-3">
        {description}
        </p>
    </div>
</div>
