---
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section class="relative text-[var(--text-color)] py-24 px-6 text-center overflow-hidden">
    <div class="max-w-xl mx-auto">
      <h1 class="text-6xl font-extrabold mb-4 animate-bounce">404</h1>
      <h2 class="text-3xl font-semibold mb-6">Oops! Page not found.</h2>
      <p class="text-[var(--text-gray)] mb-8">
        The page you're looking for doesn't exist, or maybe it moved. But don't worry, we've got you covered.
      </p>
      <a 
        href="/" 
        class="btn btn-primary"
      >
        Back to Home
      </a>
    </div>
  </section>

  <Footer />
</Layout>
